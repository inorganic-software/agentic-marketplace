def add_json_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", metavar="fields", nargs="?", const="", help="Output JSON with the specified fields")
    parser.add_argument("-q", "--jq", metavar="expression", help="Filter JSON output using a jq expression")


def add_repo_flag(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("-R", "--repo", metavar="[HOST/]OWNER/REPO", help="Select another repository using the [HOST/]OWNER/REPO format")


def parse(argv: list[str]) -> argparse.Namespace:
    args, extra = build_parser().parse_known_args(argv)
    for arg in extra:
        if arg.startswith("-"):
            raise GhError(f"unknown flag: {arg.split('=')[0]}", gap=True)
    if extra:
        raise GhError(f"accepts at most 1 arg(s), received {1 + len(extra)}")
    if getattr(args, "repo", None) not in (None, REPO, f"github.com/{REPO}", REPO_URL):
        raise GhError(f"GraphQL: Could not resolve to a Repository with the name '{args.repo}'. (repository)")
    return args


# --- git --------------------------------------------------------------------------


def git(*args: str, origin: bool = False, cwd: str | None = None, env: dict | None = None, check: bool = True) -> str:
    command = ["git", *(["--git-dir", str(ORIGIN)] if origin else []), *args]
    proc = subprocess.run(command, cwd=cwd, env={**os.environ, **(env or {})}, input="", capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise GhError(f"git {' '.join(args)}: {proc.stderr.strip()}")
    return proc.stdout.strip()


def current_branch() -> str:
    return git("rev-parse", "--abbrev-ref", "HEAD")


def remote_sha(branch: str) -> str | None:
    return git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", origin=True, check=False) or None


def now() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- pull requests ----------------------------------------------------------------


def load_prs() -> dict[int, dict]:
    """Every PR by number: the fixture's, then what the agent did, which wins."""
    prs = {}
    if FIXTURE_PR.is_file():
        pr = json.loads(FIXTURE_PR.read_text())
        prs[pr["number"]] = pr
    refs = git("for-each-ref", "--format=%(refname)", "refs/pull/", origin=True)
    for ref in filter(None, refs.splitlines()):
        if ref.endswith("/meta"):
            pr = json.loads(git("log", "-1", "--format=%B", ref, origin=True))
            prs[pr["number"]] = pr
    for pr in prs.values():
        pr.setdefault("body", "")
        pr.setdefault("isDraft", False)
        pr.setdefault("reviewDecision", "REVIEW_REQUIRED")
        pr.setdefault("labels", [])
        pr.setdefault("checks", [])
        pr.setdefault("createdAt", now())
        pr["url"] = f"{REPO_URL}/pull/{pr['number']}"
    return prs


def save_pr(pr: dict) -> None:
    """A new commit on refs/pull/<n>/meta with the PR as its message."""
    ref = f"refs/pull/{pr['number']}/meta"
    parent = git("rev-parse", "--verify", "--quiet", ref, origin=True, check=False)
    tree = git("hash-object", "-t", "tree", "-w", "--stdin", origin=True)
    record = {k: v for k, v in pr.items() if k != "url"}
    sha = git("commit-tree", tree, *(["-p", parent] if parent else []), "-m", json.dumps(record, ensure_ascii=False), origin=True, env=META_IDENTITY)
    git("update-ref", ref, sha, origin=True)


def find_pr(selector: str | None, prs: dict[int, dict]) -> dict:
    """The PR a command points at: a number, a URL or a branch; by default the open PR
    of the current branch."""
    if selector:
        number = selector.rstrip("/").rsplit("/", 1)[-1].lstrip("#")
        if number.isdigit():
            if int(number) in prs:
                return prs[int(number)]
            raise GhError(f"GraphQL: Could not resolve to a PullRequest with the number of {number}. (repository.pullRequest)")
        branch = selector
    else:
        branch = current_branch()
    matches = [pr for pr in prs.values() if pr["headRefName"] == branch]
    open_matches = [pr for pr in matches if pr["state"] == "OPEN"]
    if open_matches or matches:
        return (open_matches or matches)[-1]
    raise GhError(f'no pull requests found for branch "{branch}"')


def checks_state(pr: dict) -> str:
    """SUCCESS, FAILURE, PENDING, or NONE when the PR has no checks."""
    conclusions = [c.get("conclusion") or "PENDING" for c in pr["checks"]]
    if not conclusions:
        return "NONE"
    if any(c not in ("SUCCESS", "SKIPPED", "NEUTRAL", "PENDING") for c in conclusions):
        return "FAILURE"
    return "PENDING" if "PENDING" in conclusions else "SUCCESS"


def merge_state(pr: dict) -> str:
    if pr["state"] != "OPEN":
        return "UNKNOWN"
    if pr["isDraft"]:
        return "DRAFT"
    if pr["reviewDecision"] != "APPROVED" or checks_state(pr) in ("FAILURE", "PENDING"):
        return "BLOCKED"
    return "CLEAN"


def pr_json(pr: dict) -> dict:
    """The PR with the fields of `gh pr view --json`."""
    return {
        "number": pr["number"],
        "title": pr["title"],
        "body": pr["body"],
        "state": pr["state"],
        "isDraft": pr["isDraft"],
        "url": pr["url"],
        "author": {"login": USER},
        "baseRefName": pr["baseRefName"],
        "headRefName": pr["headRefName"],
        "reviewDecision": pr["reviewDecision"],
        "mergeable": "MERGEABLE" if pr["state"] == "OPEN" else "UNKNOWN",
        "mergeStateStatus": merge_state(pr),
        "labels": [{"name": name} for name in pr["labels"]],
        "statusCheckRollup": [
            {"__typename": "CheckRun", "name": c["name"], "status": "COMPLETED" if c.get("conclusion") else "IN_PROGRESS", "conclusion": c.get("conclusion") or ""}
            for c in pr["checks"]
        ],
        "autoMergeRequest": pr.get("autoMergeRequest"),
        "createdAt": pr["createdAt"],
        "mergedAt": pr.get("mergedAt"),
        "closed": pr["state"] != "OPEN",
    }


# The fields `--json` can ask for on a PR.
PR_FIELDS = list(pr_json({
    "number": 0, "title": "", "body": "", "state": "OPEN", "isDraft": False, "url": "", "baseRefName": "",
    "headRefName": "", "reviewDecision": "", "labels": [], "checks": [], "createdAt": "",
}))  # fmt: skip


def json_fields(fields: str, available: list[str]) -> list[str]:
    """The fields of `--json fields`, as gh checks them."""
    if not fields:
        raise GhError("Specify one or more comma-separated fields for `--json`:\n  " + "\n  ".join(sorted(available)))
    wanted = [f.strip() for f in fields.split(",") if f.strip()]
    for field in wanted:
        if field not in available:
            raise GhError(f'Unknown JSON field: "{field}"\nAvailable fields:\n  ' + "\n  ".join(sorted(available)), gap=True)
    return wanted


def emit_json(data, jq: str | None) -> None:
    """`data` as JSON, or filtered by `--jq` with raw strings, as gh does."""
    text = json.dumps(data, ensure_ascii=False)
    if jq is None:
        print(text)
        return
    try:
        proc = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True)
    except FileNotFoundError:
        raise GhError("jq is not installed: the gh stub needs it for --jq", gap=True) from None
    if proc.returncode != 0:
        raise GhError(proc.stderr.strip())
    print(proc.stdout, end="")


def output_json(data, fields: str, jq: str | None, available: list[str]) -> None:
    """--json fields [--jq expression] of an object or a list: only the fields asked for."""
    wanted = json_fields(fields, available)
    pick = lambda item: {f: item[f] for f in wanted}  # noqa: E731
    emit_json([pick(d) for d in data] if isinstance(data, list) else pick(data), jq)


# --- commands ---------------------------------------------------------------------


def pr_create(args) -> None:
    prs = load_prs()
    base = args.base or DEFAULT_BRANCH
    head = args.head or current_branch()
    if head == base:
        raise GhError(f'head branch "{head}" is the same as base branch "{base}", cannot create a pull request')
    if remote_sha(head) is None:
        raise GhError("aborted: you must first push the current branch to a remote, or use the --head flag")
    for pr in prs.values():
        if pr["headRefName"] == head and pr["baseRefName"] == base and pr["state"] == "OPEN":
            raise GhError(f'a pull request for branch "{head}" into branch "{base}" already exists:\n{pr["url"]}')
    title, body = args.title, args.body
    if args.body_file:
        body = sys.stdin.read() if args.body_file == "-" else Path(args.body_file).read_text()
    if args.fill:
        commits = git("log", "--reverse", "--format=%s%x00%b%x01", f"{remote_sha(base)}..{remote_sha(head)}", origin=True)
        first = [c.split("\0") for c in commits.split("\x01") if c.strip()]
        if title is None:
            title = first[0][0].strip() if len(first) == 1 else head
        if body is None:
            body = first[0][1].strip() if len(first) == 1 else "\n".join(f"- {s.strip()}" for s, _ in first)
    if title is None or body is None:
        raise GhError("must provide `--title` and `--body` (or `--fill` or `fill-first` or `--fillverbose`) when not running interactively")
    number = max([FIRST_PR - 1, *prs]) + 1
    pr = {
        "number": number, "title": title, "body": body, "state": "OPEN", "isDraft": args.draft,
        "baseRefName": base, "headRefName": head, "reviewDecision": "REVIEW_REQUIRED",
        "labels": args.label, "reviewers": args.reviewer, "assignees": args.assignee,
        "checks": [], "createdAt": now(),
    }  # fmt: skip
    git("update-ref", f"refs/pull/{number}/head", remote_sha(head), origin=True)
    save_pr(pr)
    print(f"{REPO_URL}/pull/{number}")


def pr_view(args) -> None:
    pr = find_pr(args.pr, load_prs())
    if args.json is not None:
        output_json(pr_json(pr), args.json, args.jq, PR_FIELDS)
        return
    reviews = {"APPROVED": "Approved", "CHANGES_REQUESTED": "Changes requested"}.get(pr["reviewDecision"])
    lines = [
        f"title:\t{pr['title']}",
        f"state:\t{'DRAFT' if pr['isDraft'] and pr['state'] == 'OPEN' else pr['state']}",
        f"author:\t{USER}",
        f"labels:\t{', '.join(pr['labels'])}",
        f"assignees:\t{', '.join(pr.get('assignees', []))}",
        f"reviewers:\t{'code-owner (' + reviews + ')' if reviews else ', '.join(pr.get('reviewers', []))}",
        "projects:\t",
        "milestone:\t",
        f"number:\t{pr['number']}",
        f"url:\t{pr['url']}",
        f"auto-merge:\t{'enabled' if pr.get('autoMergeRequest') else 'disabled'}",
        "--",
        pr["body"],
    ]
    print("\n".join(lines))


def pr_list(args) -> None:
    prs = list(load_prs().values())
    if args.state != "all":
        prs = [pr for pr in prs if pr["state"] == args.state.upper()]
    if args.head:
        prs = [pr for pr in prs if pr["headRefName"] == args.head]
    if args.base:
        prs = [pr for pr in prs if pr["baseRefName"] == args.base]
    prs = sorted(prs, key=lambda pr: -pr["number"])[: args.limit]
    if args.json is not None:
        output_json([pr_json(pr) for pr in prs], args.json, args.jq, PR_FIELDS)
        return
    for pr in prs:
        print(f"{pr['number']}\t{pr['title']}\t{pr['headRefName']}\t{'DRAFT' if pr['isDraft'] else pr['state']}\t{pr['createdAt']}")




def pr_status(args) -> None:
    prs = load_prs()
    branch = current_branch()
    mine = [pr for pr in prs.values() if pr["state"] == "OPEN"]
    current = next((pr for pr in prs.values() if pr["headRefName"] == branch), None)
    if args.json is not None:
        wanted = json_fields(args.json, PR_FIELDS)
        pick = lambda pr: {f: pr_json(pr)[f] for f in wanted}  # noqa: E731
        emit_json({"currentBranch": pick(current) if current else None, "createdBy": [pick(pr) for pr in mine], "needsReview": []}, args.jq)
        return

    def describe(pr: dict) -> str:
        review = {"APPROVED": "Review approved", "CHANGES_REQUESTED": "Changes requested"}.get(pr["reviewDecision"], "Review required")
        checks = {"SUCCESS": "Checks passing", "FAILURE": "Some checks failing", "PENDING": "Checks pending", "NONE": "No checks"}[checks_state(pr)]
        state = "" if pr["state"] == "OPEN" else f" - {pr['state'].capitalize()}"
        return f"  #{pr['number']}  {pr['title']} [{pr['headRefName']}]\n  - {checks} - {review}{state}"

    lines = [f"Relevant pull requests in {REPO}", "", "Current branch"]
    lines.append(describe(current) if current else f"  There is no pull request associated with [{branch}]")
    lines += ["", "Created by you"]
    lines += [describe(pr) for pr in mine] or ["  You have no open pull requests"]
    lines += ["", "Requesting a code review from you", "  You have no pull requests to review"]
    print("\n".join(lines))


def pr_checks(args) -> None:
    pr = find_pr(args.pr, load_prs())
    rows = [
        {"name": c["name"], "state": c.get("conclusion") or "PENDING",
         "bucket": {"SUCCESS": "pass", "FAILURE": "fail", "SKIPPED": "skipping", "CANCELLED": "cancel"}.get(c.get("conclusion") or "", "pending"),
         "link": f"{REPO_URL}/actions/runs/{i + 1}", "workflow": "ci"}
        for i, c in enumerate(pr["checks"])
    ]  # fmt: skip
    if not rows:
        raise GhError(f"no checks reported on the '{pr['headRefName']}' branch")
    if args.json is not None:
        output_json(rows, args.json, args.jq, ["bucket", "link", "name", "state", "workflow"])
    else:
        for row in rows:
            print(f"{row['name']}\t{row['bucket']}\t2s\t{row['link']}\t")
    state = checks_state(pr)
    if state == "FAILURE":
        raise SystemExit(1)
    if state == "PENDING":
        raise SystemExit(8)


def pr_edit(args) -> None:
    pr = find_pr(args.pr, load_prs())
    if args.title is not None:
        pr["title"] = args.title
    if args.body is not None:
        pr["body"] = args.body
    if args.body_file:
        pr["body"] = sys.stdin.read() if args.body_file == "-" else Path(args.body_file).read_text()
    if args.base:
        pr["baseRefName"] = args.base
    pr["labels"] = [name for name in [*pr["labels"], *args.add_label] if name not in args.remove_label]
    save_pr(pr)
    print(pr["url"])


def pr_merge(args) -> None:
    pr = find_pr(args.pr, load_prs())
    name = f"{REPO}#{pr['number']}"
    if pr["state"] == "MERGED":
        raise GhError(f"X Pull request {name} was already merged")
    if pr["state"] != "OPEN":
        raise GhError(f"X Pull request {name} is closed")
    methods = [m for m in ("squash", "merge", "rebase") if getattr(args, m)]
    if not methods:
        raise GhError("--merge, --rebase, or --squash required when not running interactively")
    if len(methods) > 1:
        raise GhError("only one of --merge, --rebase, or --squash can be enabled")
    method = methods[0]
    if merge_state(pr) != "CLEAN":
        if args.auto:
            pr["autoMergeRequest"] = {"mergeMethod": method.upper()}
            save_pr(pr)
            print(f"✓ Pull request {name} will be automatically merged via {method} when all requirements are met")
            return
        raise GhError(
            f"X Pull request {name} is not mergeable: the base branch policy prohibits the merge.\n"
            "To have the pull request merged after all the requirements have been met, add the `--auto` flag.\n"
            "To use administrator privileges to immediately merge the pull request, add the `--admin` flag."
        )
    head, base = pr["headRefName"], pr["baseRefName"]
    if remote_sha(head) is None:
        raise GhError(f"X Pull request {name}: the head branch {head} no longer exists")
    merge_on_origin(pr, method, args.subject, args.body)
    pr.update(state="MERGED", mergedAt=now())
    save_pr(pr)
    verb = {"squash": "Squashed and merged", "merge": "Merged", "rebase": "Rebased and merged"}[method]
    print(f"✓ {verb} pull request {name} ({pr['title']})")
    git("branch", "-D", head, origin=True)
    if args.delete_branch:
        if current_branch() == head:
            if git("rev-parse", "--verify", "--quiet", f"refs/heads/{base}", check=False):
                git("switch", "-q", base)
            else:
                git("switch", "-q", "-c", base, "--track", f"origin/{base}")
        git("branch", "-q", "-D", head, check=False)
        print(f"✓ Deleted local branch {head} and switched to branch {base}")
        print(f"✓ Deleted remote branch {head}")


def merge_on_origin(pr: dict, method: str, subject: str | None, body: str | None) -> None:
    """Merge the PR's head into its base on origin, committed by GitHub, as github.com
    does: in a clone of its own, so the agent's workspace is left as it was."""
    head, base = pr["headRefName"], pr["baseRefName"]
    with tempfile.TemporaryDirectory() as clone:
        git("clone", "-q", "--branch", base, str(ORIGIN), clone)
        run = lambda *a: git(*a, cwd=clone, env=GITHUB_IDENTITY)  # noqa: E731
        commits = run("log", "--reverse", "--format=%s", f"{base}..origin/{head}").splitlines()
        if method == "squash":
            run("merge", "-q", "--squash", f"origin/{head}")
            message = subject or f"{pr['title']} (#{pr['number']})"
            run("commit", "-q", "-m", message, "-m", body if body is not None else "\n".join(f"* {c}" for c in commits))
        elif method == "merge":
            message = subject or f"Merge pull request #{pr['number']} from example/{head}"
            run("merge", "-q", "--no-ff", "-m", message, "-m", body if body is not None else pr["title"], f"origin/{head}")
        else:
            for sha in run("rev-list", "--reverse", f"{base}..origin/{head}").splitlines():
                run("cherry-pick", sha)
        run("push", "-q", "origin", base)


def gh_main(argv: list[str]) -> None:
    if argv[:1] == ["help"]:
        argv = [*argv[1:], "--help"]
    args = parse(argv)
    if args.version or args.command == "version":
        print(VERSION)
        return
    handlers = {
        ("auth", "status"): auth_status,
        ("label", "list"): label_list,
        ("repo", "view"): repo_view,
        ("pr", "create"): pr_create,
        ("pr", "view"): pr_view,
        ("pr", "list"): pr_list,
        ("pr", "status"): pr_status,
        ("pr", "checks"): pr_checks,
        ("pr", "edit"): pr_edit,
        ("pr", "merge"): pr_merge,
    }
    handlers[(args.group, args.command)](args)


def auth_status(args) -> None:
    print(f"github.com\n  ✓ Logged in to github.com account {USER} (keyring)\n  - Active account: true")
    print("  - Git operations protocol: https\n  - Token: gho_************************************")


def label_list(args) -> None:
    if args.json is not None:
        output_json(LABELS, args.json, args.jq, ["color", "description", "name"])
        return
    for label in LABELS:
        print(f"{label['name']}\t{label['description']}\t#{label['color']}")


def repo_view(args) -> None:
    if args.repository not in (None, REPO):
        raise GhError(f"GraphQL: Could not resolve to a Repository with the name '{args.repository}'. (repository)")
    data = {
        "name": "greeting", "nameWithOwner": REPO, "owner": {"login": "example"}, "url": REPO_URL,
        "description": "Greets people.", "defaultBranchRef": {"name": DEFAULT_BRANCH},
        "isPrivate": False, "visibility": "PUBLIC",
    }  # fmt: skip
    if args.json is not None:
        output_json(data, args.json, args.jq, list(data))
        return
    readme = git("show", f"{DEFAULT_BRANCH}:README.md", origin=True, check=False)
    print(f"name:\t{REPO}\ndescription:\t{data['description']}\n--\n{readme}")


def log_call(argv: list[str]) -> None:
    with open(SANDBOX / "gh.log", "a") as log:
        log.write("gh" + "".join(f" {shlex.quote(a)}" for a in argv) + "\n")


def log_gap(argv: list[str], reason: str) -> None:
    with open(SANDBOX / "stub-gaps.jsonl", "a") as gaps:
        gaps.write(json.dumps({"stub": "gh", "argv": argv, "reason": reason}, ensure_ascii=False) + "\n")


def main() -> int:
    argv = sys.argv[1:]
    if argv[:2] == ["auth", "token"]:
        return 1
    log_call(argv)
    try:
        gh_main(argv)
    except GhError as e:
        if e.gap:
            log_gap(argv, str(e).splitlines()[0])
        print(str(e), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
