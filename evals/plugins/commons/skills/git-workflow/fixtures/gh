#!/usr/bin/env python3
"""`gh` stub for the git-workflow fixtures: GitHub, without leaving the machine.

`install_gh_stub` (common.sh) copies it to $EVAL_SANDBOX/bin, first in the PATH. It
imitates the commands and flags the agents have been seen to use, as gh 2.100.0 does
when it is not run in a terminal, against the fixture's bare remote
$EVAL_SANDBOX/origin.git standing in for github.com/example/greeting. Anything else
fails as the real gh would (`unknown flag: --foo`), and is appended to
$EVAL_SANDBOX/stub-gaps.jsonl, which the eval report shows: a gap of the stub, not a
mistake of the agent.

What the fixture sets up, and what the agent did, live apart:
  - $EVAL_SANDBOX/gh/pr.json (optional, written by `write_pr`): a PR that already
    exists when the agent starts, approved or not, with its checks.
  - origin.git: each PR the agent creates, edits or merges is a chain of commits on
    refs/pull/<n>/meta whose message is the PR as JSON, and its head on
    refs/pull/<n>/head. A merge is committed by `GitHub <noreply@github.com>`, as on
    github.com, so the checks can tell it from a commit pushed by hand.
Every call is logged to $EVAL_SANDBOX/gh.log, which the judge sees, except `auth
token`: Copilot CLI runs it at startup to look for a GitHub token (checked on 1.0.91),
it is not the agent's work, and it must fail so the session keeps the runner's login.
"""

import argparse
import json
import os
import shlex
import subprocess
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path

VERSION = "gh version 2.100.0 (2026-09-03)\nhttps://github.com/cli/cli/releases/tag/v2.100.0"
REPO = "example/greeting"
REPO_URL = f"https://github.com/{REPO}"
DEFAULT_BRANCH = "main"
FIRST_PR = 7
USER = "eval-agent"
GITHUB_IDENTITY = {"GIT_COMMITTER_NAME": "GitHub", "GIT_COMMITTER_EMAIL": "noreply@github.com"}
META_IDENTITY = {**GITHUB_IDENTITY, "GIT_AUTHOR_NAME": "GitHub", "GIT_AUTHOR_EMAIL": "noreply@github.com"}
LABELS = [
    {"name": "bug", "description": "Something isn't working", "color": "d73a4a"},
    {"name": "documentation", "description": "Improvements or additions to documentation", "color": "0075ca"},
    {"name": "enhancement", "description": "New feature or request", "color": "a2eeef"},
]

# The stub lives in <sandbox>/bin: the agent's environment does not say where the sandbox is.
SANDBOX = Path(__file__).resolve().parent.parent
ORIGIN = SANDBOX / "origin.git"
FIXTURE_PR = SANDBOX / "gh" / "pr.json"


class GhError(Exception):
    """Ends the command as gh does: the message on stderr and exit code 1. A `gap` is
    something real gh does that this stub does not imitate."""

    def __init__(self, message: str, gap: bool = False):
        super().__init__(message)
        self.gap = gap


# --- command line -----------------------------------------------------------------


class Parser(argparse.ArgumentParser):
    """argparse with gh's errors and gh's `--help`: short, without side effects."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, add_help=False, allow_abbrev=False, **kwargs)
        self.add_argument("-h", "--help", action=HelpAction, help="Show help for command")

    def error(self, message: str):
        if "invalid choice:" in message:
            choice = message.split("invalid choice: ")[1].split(" ")[0].strip("'")
            raise GhError(f'unknown command "{choice}" for "{self.prog}"', gap=True)
        if "expected one argument" in message:
            flag = message.split("argument ")[1].split(":")[0].split("/")[-1]
            raise GhError(f"flag needs an argument: {flag}")
        if "the following arguments are required" in message:
            print_help(self)
            raise SystemExit(0)
        raise GhError(message)

    def subcommands(self, dest: str = "command") -> argparse._SubParsersAction:
        return self.add_subparsers(dest=dest, required=True, parser_class=Parser)


class HelpAction(argparse.Action):
    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, default=argparse.SUPPRESS, **kwargs)

    def __call__(self, parser, namespace, values, option_string=None):
        print_help(parser)
        raise SystemExit(0)


def print_help(parser: argparse.ArgumentParser) -> None:
    lines = [parser.description or "", "", "USAGE", f"  {parser.prog} {parser.usage or '[flags]'}"]
    commands = [a for a in parser._actions if isinstance(a, argparse._SubParsersAction)]
    if commands:
        lines += ["", "COMMANDS"]
        lines += [f"  {c.dest}:  {c.help}" for c in commands[0]._choices_actions]
    flags = [a for a in parser._actions if a.option_strings and a.dest != "help"]
    if flags:
        lines += ["", "FLAGS"]
        for a in flags:
            value = "" if a.nargs == 0 else f" {a.metavar or a.dest}"
            lines.append(f"  {', '.join(a.option_strings)}{value}  {a.help or ''}")
    lines += ["", "INHERITED FLAGS", "  --help  Show help for command"]
    print("\n".join(lines).strip("\n"))


def build_parser() -> Parser:
    gh = Parser(prog="gh", description="Work seamlessly with GitHub from the command line.", usage="<command> <subcommand> [flags]")
    gh.add_argument("--version", action="store_true", help="Show gh version")
    commands = gh.subcommands("group")

    auth = commands.add_parser("auth", help="Authenticate gh and git with GitHub", description="Authenticate gh and git with GitHub")
    auth_commands = auth.subcommands()
    auth_commands.add_parser("status", help="Display active account and authentication state", description="Display active account and authentication state on each known GitHub host.")
    auth_commands.add_parser("token", help="Print the authentication token gh uses", description="Print the authentication token gh uses for a hostname and account.")

    commands.add_parser("version", help="Show gh version", description="Show gh version")

    label = commands.add_parser("label", help="Manage labels", description="Work with GitHub labels.")
    label_list = label.subcommands().add_parser("list", help="List labels in a repository", description="Display labels in a GitHub repository.")
    add_json_flags(label_list)
    add_repo_flag(label_list)

    repo = commands.add_parser("repo", help="Manage repositories", description="Work with GitHub repositories.")
    repo_view = repo.subcommands().add_parser("view", help="View a repository", description="Display the description and the README of a GitHub repository.", usage="[<repository>] [flags]")
    repo_view.add_argument("repository", nargs="?")
    add_json_flags(repo_view)

    pr = commands.add_parser("pr", help="Manage pull requests", description="Work with GitHub pull requests.")
    pr_commands = pr.subcommands()

    create = pr_commands.add_parser("create", help="Create a pull request", description="Create a pull request on GitHub.", usage="[flags]")
    create.add_argument("-B", "--base", metavar="branch", help="The branch into which you want your code merged")
    create.add_argument("-H", "--head", metavar="branch", help="The branch that contains commits for your pull request")
    create.add_argument("-t", "--title", metavar="string", help="Title for the pull request")
    create.add_argument("-b", "--body", metavar="string", help="Body for the pull request")
    create.add_argument("-F", "--body-file", metavar="file", help='Read body text from file (use "-" to read from standard input)')
    create.add_argument("-f", "--fill", action="store_true", help="Use commit info for title and body")
    create.add_argument("-d", "--draft", action="store_true", help="Mark pull request as a draft")
    create.add_argument("-l", "--label", metavar="name", action="append", default=[], help="Add labels by name")
    create.add_argument("-r", "--reviewer", metavar="handle", action="append", default=[], help="Request reviews from people or teams by their handle")
    create.add_argument("-a", "--assignee", metavar="login", action="append", default=[], help='Assign people by their login. Use "@me" to self-assign.')
    add_repo_flag(create)

    view = pr_commands.add_parser("view", help="View a pull request", description="Display the title, body, and other information about a pull request.", usage="[<number> | <url> | <branch>] [flags]")
    view.add_argument("pr", nargs="?")
    add_json_flags(view)
    add_repo_flag(view)

    pr_list = pr_commands.add_parser("list", help="List pull requests in a repository", description="List pull requests in a GitHub repository.")
    pr_list.add_argument("-H", "--head", metavar="branch", help="Filter by head branch")
    pr_list.add_argument("-B", "--base", metavar="branch", help="Filter by base branch")
    pr_list.add_argument("-s", "--state", metavar="string", default="open", choices=["open", "closed", "merged", "all"], help='Filter by state: {open|closed|merged|all} (default "open")')
    pr_list.add_argument("-L", "--limit", metavar="int", type=int, default=30, help="Maximum number of items to fetch (default 30)")
    add_json_flags(pr_list)
    add_repo_flag(pr_list)

    status = pr_commands.add_parser("status", help="Show status of relevant pull requests", description="Show status of relevant pull requests.")
    add_json_flags(status)
    add_repo_flag(status)

    checks = pr_commands.add_parser("checks", help="Show CI status for a single pull request", description="Show CI status for a single pull request.", usage="[<number> | <url> | <branch>] [flags]")
    checks.add_argument("pr", nargs="?")
    checks.add_argument("--watch", action="store_true", help="Watch checks until they finish")
    checks.add_argument("--required", action="store_true", help="Only show checks that are required")
    add_json_flags(checks)
    add_repo_flag(checks)

    edit = pr_commands.add_parser("edit", help="Edit a pull request", description="Edit a pull request.", usage="[<number> | <url> | <branch>] [flags]")
    edit.add_argument("pr", nargs="?")
    edit.add_argument("-t", "--title", metavar="string", help="Set the new title")
    edit.add_argument("-b", "--body", metavar="string", help="Set the new body")
    edit.add_argument("-F", "--body-file", metavar="file", help='Read body text from file (use "-" to read from standard input)')
    edit.add_argument("-B", "--base", metavar="branch", help="Change the base branch for this pull request")
